# Copy this file to an ignored local environment file before deployment.
# Do not place credentials, host addresses, or private keys in this repository.

# Go API service
API_LISTEN_ADDR=127.0.0.1:9002
MYSQL_DSN=
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
SECURITY_SERVICE_URL=http://127.0.0.1:9001

# Rust security service
SECURITY_LISTEN_ADDR=127.0.0.1:9001
SECURITY_SERVICE_KEY=
# Generate each secret independently (e.g. openssl rand -hex 32); never commit it.
JWT_SECRET=
AES_KEY=

# Captcha service, when enabled
CAPTCHA_LISTEN_ADDR=127.0.0.1:3001
CAPTCHA_SERVICE_URL=http://127.0.0.1:3001
CAPTCHA_SERVICE_KEY=
CAPTCHA_SECRET=
ALLOW_THIRD_PARTY_EMAIL_LOOKUP=false


# Stable unique email index key; separate from AES/JWT keys. Back up securely.
EMAIL_LOOKUP_SECRET=
